# Copy to `.env` and fill in. `.env` is gitignored; never commit a real key.

# --- NL to Cedar compiler backend (ADR-040) -------------------------------------
# Which model serves the compiler. Unset means: use Groq if GROQ_API_KEY is present,
# otherwise fall back to the local Ollama model, so a machine with no key still runs.
#
#   groq    hosted inference. The prototype default — a local 4-bit 7B measured a
#           median 45.2 s per policy on a development GPU (ADR-038), and a cloud CPU
#           VM is markedly worse.
#   ollama  strictly local, no egress. The production destination once inference
#           hardware is funded. Requires `ollama pull qwen2.5:7b-instruct-q4_0`.
AGENTIAM_LLM_BACKEND=groq

# Required when the backend is groq. Get one at https://console.groq.com/keys
GROQ_API_KEY=
