# Development happens on Windows; CI runs on Linux. Pin line endings so a checkout on
# either host produces files the other can execute.

* text=auto eol=lf

# Must be LF regardless of host — CRLF breaks these outright.
Makefile        text eol=lf
*.sh            text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf

# PowerShell is the one place CRLF is the native convention.
*.ps1           text eol=crlf

# Binary — never touch.
*.png           binary
*.jpg           binary
*.pdf           binary
*.gz            binary
*.zip           binary

# Generated by uv; keep diffs readable but do not review by hand.
uv.lock         linguist-generated=true
