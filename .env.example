# Copy to `.env` and fill in. `.env` is gitignored; never commit a real key.

# --- NL to Cedar compiler backend (ADR-040) -------------------------------------
# Which model serves the compiler. Unset means: Gemini if GEMINI_API_KEY is present,
# else Groq if GROQ_API_KEY is present, else the local Ollama model — so a machine with
# no key at all still runs.
#
#   gemini  hosted. Preferred of the two hosted options: its free quota is metered in
#           requests per day (1,500) rather than tokens per day, so an evaluation run
#           costs ~30 requests instead of half a budget. NOTE: Google's *unpaid* tier
#           may use submitted content to improve their products, and what is submitted
#           is the operator's policy text. Fine for a prototype, not for a customer.
#   groq    hosted. Fast, but the free tier caps at 100,000 tokens per DAY — roughly
#           55 compiles, and one 30-case evaluation run spends over half of it.
#   ollama  strictly local, no egress, no third-party data exposure. The production
#           destination. Requires `ollama pull qwen2.5:7b-instruct-q4_0`.
AGENTIAM_LLM_BACKEND=gemini

# Put real values in `.env`, never here — this file IS tracked (see the `!.env.example`
# negation in .gitignore), so a key written here goes to the repository.

# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# https://console.groq.com/keys
GROQ_API_KEY=

# --- Control plane: escalation approval + Keycloak OIDC (T-037, T-043, ADR-046) --
# Root signing key for elevated tokens minted on escalation approval — hex-encoded
# Ed25519 private key, 32 bytes (64 hex chars). Generate one locally, never reuse this
# comment as a value:
#   python -c "from biscuit_auth import KeyPair; print(KeyPair().private_key.to_bytes().hex())"
AGENTIAM_CONTROLPLANE_ROOT_PRIVATE_KEY=

# Comma-separated allowlist of `kc:<oidc-sub>` ids permitted to approve/deny escalations.
# The two demo users in deploy/keycloak/realm-export.json have fixed subs so this can be
# filled in without running Keycloak first.
AGENTIAM_CONTROLPLANE_APPROVERS=kc:11111111-1111-1111-1111-111111111111,kc:22222222-2222-2222-2222-222222222222

# Signs the session cookie (state/nonce before login, principal_id after). Any random
# string in dev; a real secret in anything that isn't.
AGENTIAM_CONTROLPLANE_SESSION_SECRET_KEY=dev-change-me-session-secret

# Keycloak realm issuer, and the console's own OIDC client — both match
# deploy/keycloak/realm-export.json's defaults, importable via `docker compose up keycloak`.
AGENTIAM_CONTROLPLANE_OIDC_ISSUER=http://localhost:8080/realms/agentiam
AGENTIAM_CONTROLPLANE_OIDC_CLIENT_ID=agentiam-console
AGENTIAM_CONTROLPLANE_OIDC_CLIENT_SECRET=dev-console-secret-change-me

# --- Tracing (T-049, ADR-047) -----------------------------------------------------
# Unset (the default) leaves every span a no-op — the T-018 baseline, unaffected. Set
# this to export real spans to the collector brought up by
# `docker compose -f docker-compose.observability.yml up -d --wait`.
AGENTIAM_PEP_OTEL_EXPORTER_ENDPOINT=http://localhost:4318/v1/traces
