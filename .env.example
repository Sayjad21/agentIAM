# Copy to `.env` and fill in. `.env` is gitignored; never commit a real key.

# --- NL to Cedar compiler backend (ADR-040) -------------------------------------
# Which model serves the compiler. Unset means: Gemini if GEMINI_API_KEY is present,
# else Groq if GROQ_API_KEY is present, else the local Ollama model — so a machine with
# no key at all still runs.
#
#   gemini  hosted. Preferred of the two hosted options: its free quota is metered in
#           requests per day (1,500) rather than tokens per day, so an evaluation run
#           costs ~30 requests instead of half a budget. NOTE: Google's *unpaid* tier
#           may use submitted content to improve their products, and what is submitted
#           is the operator's policy text. Fine for a prototype, not for a customer.
#   groq    hosted. Fast, but the free tier caps at 100,000 tokens per DAY — roughly
#           55 compiles, and one 30-case evaluation run spends over half of it.
#   ollama  strictly local, no egress, no third-party data exposure. The production
#           destination. Requires `ollama pull qwen2.5:7b-instruct-q4_0`.
AGENTIAM_LLM_BACKEND=gemini

# Put real values in `.env`, never here — this file IS tracked (see the `!.env.example`
# negation in .gitignore), so a key written here goes to the repository.

# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# https://console.groq.com/keys
GROQ_API_KEY=

# --- Control plane: escalation approval + Keycloak OIDC (T-037, T-043, ADR-046) --
# Root signing key for elevated tokens minted on escalation approval — hex-encoded
# Ed25519 private key, 32 bytes (64 hex chars). Generate one locally, never reuse this
# comment as a value:
#   python -c "from biscuit_auth import KeyPair; print(KeyPair().private_key.to_bytes().hex())"
AGENTIAM_CONTROLPLANE_ROOT_PRIVATE_KEY=

# Comma-separated allowlist of `kc:<oidc-sub>` ids permitted to approve/deny escalations.
# The two demo users in deploy/keycloak/realm-export.json have fixed subs so this can be
# filled in without running Keycloak first.
AGENTIAM_CONTROLPLANE_APPROVERS=kc:11111111-1111-1111-1111-111111111111,kc:22222222-2222-2222-2222-222222222222

# Signs the session cookie (state/nonce before login, principal_id after). Any random
# string in dev; a real secret in anything that isn't.
AGENTIAM_CONTROLPLANE_SESSION_SECRET_KEY=dev-change-me-session-secret

# Keycloak realm issuer, and the console's own OIDC client — both match
# deploy/keycloak/realm-export.json's defaults, importable via `docker compose up keycloak`.
AGENTIAM_CONTROLPLANE_OIDC_ISSUER=http://localhost:8080/realms/agentiam
AGENTIAM_CONTROLPLANE_OIDC_CLIENT_ID=agentiam-console
AGENTIAM_CONTROLPLANE_OIDC_CLIENT_SECRET=dev-console-secret-change-me

# --- Tracing (T-049, ADR-047) -----------------------------------------------------
# Unset (the default) leaves every span a no-op — the T-018 baseline, unaffected. Set
# this to export real spans to the collector brought up by
# `docker compose -f docker-compose.observability.yml up -d --wait`.
AGENTIAM_PEP_OTEL_EXPORTER_ENDPOINT=http://localhost:4318/v1/traces

# --- PEP as a deployed service (T-056, scripts/pep_service.py) --------------------
# Only needed to run the PEP as a container/service. `make check` and the test suite
# need none of these. Every one is REQUIRED when the service starts: it refuses to boot
# rather than come up looking like it enforces when it does not.

# Where proxied calls go, and where this PEP reaches the control plane. The pull path is
# the correctness backstop for revocation (spec 07 §5.2), so the URL is not optional.
AGENTIAM_PEP_UPSTREAM_BASE_URL=http://tools:8081
AGENTIAM_PEP_CONTROL_PLANE_URL=http://controlplane:8000

#   postgresql+asyncpg://<user>:<password>@postgres:5432/agentiam
AGENTIAM_PEP_DATABASE_URL=
AGENTIAM_PEP_REDIS_URL=redis://redis:6379/0

# Identifies this instance in the `leases` table. Distinct per replica.
AGENTIAM_PEP_ID=pep-1

# **One PEP process enforces budget for exactly one mandate.** `LeasePool` binds a
# mandate at construction (ADR-056); everything else the PEP does is mandate-agnostic.
AGENTIAM_PEP_MANDATE_ID=

# Root public keys this PEP will verify tokens against, comma-separated hex (32 bytes,
# 64 chars each). Plural for rotation — EC-T05 requires an old key to keep verifying
# until the tokens minted under it expire. Public keys only; the PEP never signs.
#   python -c "from biscuit_auth import KeyPair; print(KeyPair().public_key.to_bytes().hex())"
AGENTIAM_PEP_ROOT_PUBLIC_KEYS=

# The Cedar bundle and its detached Ed25519 signature. The signature is REQUIRED and
# verified at boot: an unverified bundle is an authorization layer anyone with disk
# access can rewrite (T-025). Note that hot reload and the staleness guard need a bundle
# *publisher*, which does not exist yet — see ADR-056.
AGENTIAM_PEP_POLICY_BUNDLE_PATH=/etc/agentiam/policy-bundle.json
AGENTIAM_PEP_POLICY_BUNDLE_SIG_PATH=/etc/agentiam/policy-bundle.sig
AGENTIAM_PEP_POLICY_PUBLIC_KEY=

# The route table: (method, path) -> scope/tool/args. Spec 10 §3.
AGENTIAM_PEP_ROUTES_PATH=/etc/agentiam/routes.json

# Optional. Unset disables drift detection entirely, which is a legitimate, safe
# configuration (spec 06 §2.1 — an oracle failure is advisory, never fatal) rather
# than a degraded one. Set it to wire a real RuleBasedDriftOracle against Ollama.
AGENTIAM_PEP_OLLAMA_URL=

# --- Control plane as a deployed service (T-056) ---------------------------------
# `create_app_from_env()` is the deployment entry point:
#   uvicorn agentiam_controlplane.app:create_app_from_env --factory --host 0.0.0.0
# Without a database URL it still boots and reports `database: false` on /readyz, because
# the authoring console is useful without one and a misconfiguration should be
# diagnosable rather than a crash loop.
#   postgresql+asyncpg://<user>:<password>@postgres:5432/agentiam
AGENTIAM_CONTROLPLANE_DATABASE_URL=
AGENTIAM_CONTROLPLANE_REDIS_URL=redis://redis:6379/0

# --- Local infrastructure ---------------------------------------------------------
# A native PostgreSQL already listening on 5432 shadows the compose one — measured on
# both Windows and Fedora. Set this if `docker compose up` reports "address already in
# use", or if psql connects but the app sees InvalidPasswordError.
# POSTGRES_PORT=5433

# Host ports for `make demo-up` (docker-compose.demo.yml, T-056). Change any of these if
# something else on the host already holds 8000/8080/11434.
# CONTROLPLANE_PORT=8000
# PEP_PORT=8080
# OLLAMA_PORT=11434

# The PEP is scoped to exactly one mandate (ADR-056, STATUS gap 25). `make demo-up`'s own
# placeholder mandate lets the containers start and prove the pipeline is wired; T-057's
# demo script is what mints a real one through the control plane's issuance path.
# AGENTIAM_PEP_MANDATE_ID=
