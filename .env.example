# AgentIAM — local development configuration.
#
# Copy to .env and adjust. .env is gitignored; this file is committed.
# These are development credentials for local containers only. Nothing here is a secret,
# and nothing here is used outside docker compose.

# --- Postgres ---
POSTGRES_USER=agentiam
POSTGRES_PASSWORD=agentiam
POSTGRES_DB=agentiam
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- Application ---
# Assembled from the values above; override if you point at an external instance.
DATABASE_URL=postgresql+asyncpg://agentiam:agentiam@localhost:5432/agentiam
REDIS_URL=redis://localhost:6379/0

# Fail closed on control-plane unavailability (NFR-7). Overriding this to false is a
# per-scope, audited decision — not a global convenience switch.
AGENTIAM_FAIL_OPEN=false

LOG_LEVEL=INFO
