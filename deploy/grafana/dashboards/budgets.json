{
  "uid": "agentiam-budgets",
  "title": "AgentIAM — Budgets",
  "description": "Per-mandate spend and lease utilization — PLAN.md §1197 (T-049).",
  "tags": ["agentiam"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "Per-mandate spend (committed vs. available, BDT)",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "currencyBDT", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "agentiam_controlplane_budget_committed_bdt",
          "legendFormat": "committed {{mandate_id}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "agentiam_controlplane_budget_available_bdt",
          "legendFormat": "available {{mandate_id}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 2,
      "title": "Lease utilization (settled / granted)",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.3 },
              { "color": "green", "value": 0.6 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "orientation": "horizontal", "displayMode": "gradient" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "agentiam_controlplane_lease_utilization_ratio",
          "legendFormat": "{{mandate_id}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Invariant checker",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "VIOLATION", "color": "red" } } },
            { "type": "value", "options": { "1": { "text": "OK", "color": "green" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "agentiam_controlplane_invariant_ok",
          "refId": "A"
        }
      ]
    }
  ]
}
